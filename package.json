{
  "name": "obs2deck",
  "version": "0.1.1",
  "description": "Obsidian plugin: present any note as a deckrun slide deck, one URL per note.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "node scripts/parity.mjs",
    "serve": "node scripts/serve.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "obsidian-plugin", "presentation", "slides", "deckrun"],
  "author": "Kavin Kumar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "deckrun": "^1.6.0"
  }
}
